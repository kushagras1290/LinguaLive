# LinguaLive — configuration
#
# Copy to `.env` and edit. Every value here is the default, so an empty `.env`
# behaves identically to this file. Settings are validated at startup: an
# invalid value stops the process rather than failing on the first request.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
ENVIRONMENT=development           # development | production | test
HOST=127.0.0.1
PORT=5000
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=console                # console (readable) | json (for aggregators)

# ---------------------------------------------------------------------------
# Model cache
# ---------------------------------------------------------------------------
# Where model weights live. Defaults to `models/` beside this file, which keeps
# multi-gigabyte downloads off the system drive.
# Current contents: Whisper small ~464 MB, NLLB-600M ~2.4 GB, ~145 MB per MMS voice.
MODEL_CACHE_DIR=./models

# ---------------------------------------------------------------------------
# Engine selection
# ---------------------------------------------------------------------------
# Inference sits behind an interface, so these choose *where* models run without
# changing the HTTP API at all.
ENGINE_ASR=faster_whisper         # faster_whisper | hf_inference
ENGINE_MT=nllb_local              # nllb_local | hf_inference
ENGINE_TTS=chain                  # chain | mms | gtts | formant

# Backends the `chain` engine tries, in order. Keep `formant` last: it needs no
# weights and no network, so synthesis can never fail outright.
TTS_CHAIN=mms,gtts,formant

# Load models during startup rather than on first request. Leave off for fast
# dev restarts; turn on in production so the first user does not wait.
EAGER_LOAD_MODELS=false

# ---------------------------------------------------------------------------
# Speech recognition (Whisper)
# ---------------------------------------------------------------------------
# tiny | base | small | medium | large-v3, or any CTranslate2 model id.
# Measured on an 8-thread CPU: `small` transcribes ~6.6s of speech in ~6s.
# `large-v3` is far more accurate but roughly 5x slower.
WHISPER_MODEL=small
WHISPER_DEVICE=auto               # auto | cpu | cuda
WHISPER_COMPUTE_TYPE=auto         # auto | int8 | int8_float16 | float16 | float32
WHISPER_BEAM_SIZE=5

# ---------------------------------------------------------------------------
# Translation (NLLB-200)
# ---------------------------------------------------------------------------
NLLB_MODEL=facebook/nllb-200-distilled-600M
NLLB_NUM_BEAMS=4
NLLB_STREAM_NUM_BEAMS=4
NLLB_MAX_INPUT_TOKENS=512
NLLB_MAX_OUTPUT_TOKENS=512

# Dynamic int8 quantisation of the Linear layers, CPU only.
# Measured here: 11.1s -> 2.3s per translation, a 5x speedup, output unchanged.
# There is no good reason to disable this on CPU.
NLLB_QUANTIZE=true

# ---------------------------------------------------------------------------
# Remote inference (only when an ENGINE_* is set to hf_inference)
# ---------------------------------------------------------------------------
# Required in that case; startup fails with a clear message if it is missing.
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx
HF_ASR_MODEL=openai/whisper-large-v3
HF_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------------
# Limits
# ---------------------------------------------------------------------------
MAX_UPLOAD_BYTES=26214400         # 25 MB
MAX_AUDIO_SECONDS=300
MAX_TEXT_CHARS=5000
INFERENCE_TIMEOUT_SECONDS=120

# ---------------------------------------------------------------------------
# Live streaming
# ---------------------------------------------------------------------------
STREAM_SAMPLE_RATE=16000          # must match the browser AudioWorklet
STREAM_WINDOW_SECONDS=8.0         # rolling buffer kept for re-transcription
STREAM_SILENCE_SECONDS=0.8        # pause that closes an utterance
STREAM_MIN_CHUNK_SECONDS=1.0      # audio needed before the first partial
STREAM_VAD_THRESHOLD=0.015        # raise in a noisy room, lower for quiet speech
STREAM_MAX_SESSION_SECONDS=900

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Origins allowed to call /api/*. Only matters when a browser client is served
# from a different origin than this API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
